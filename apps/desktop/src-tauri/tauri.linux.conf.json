{
  "productName": "io.github.efedogan.grapefruit",
  "app": {
    "enableGTKAppId": true
  },
  "bundle": {
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "poppler-utils",
          "libreoffice-core-nogui",
          "libreoffice-writer-nogui",
          "libreoffice-impress-nogui",
          "libreoffice-draw-nogui",
          "libreoffice-calc-nogui"
        ],
        "recommends": [
          "gnome-shell",
          "python3-nautilus"
        ],
        "files": {
          "/usr/share/gnome-shell/extensions/grapefruit@io.github.efedogan": "../../../integrations/gnome-shell/grapefruit@io.github.efedogan/",
          "/usr/share/nautilus-python/extensions/grapefruit.py": "../../../integrations/nautilus/grapefruit.py",
          "/usr/share/doc/io-github-efedogan-grapefruit/README.integration.md": "../../../integrations/README.md"
        },
        "desktopTemplate": "linux/grapefruit.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/grapefruit.desktop.hbs"
      }
    }
  }
}
