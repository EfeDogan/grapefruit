{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grapefruit",
  "version": "0.3.5",
  "identifier": "io.github.efedogan.grapefruit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grapefruit",
        "width": 940,
        "height": 820,
        "minWidth": 680,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": true
      },
      {
        "label": "overlay",
        "title": "Grapefruit Quick Menu",
        "width": 420,
        "height": 420,
        "minWidth": 420,
        "minHeight": 420,
        "maxWidth": 420,
        "maxHeight": 420,
        "center": true,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Convert documents and run quick file actions from a system-wide menu.",
    "icon": ["icons/icon.png"]
  }
}
